      <aliases enabled='yes' />
      <column caption='Total Population' datatype='integer' name='[Calculation_3214584994672668673]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM ([Pop])' />
      </column>
      <column caption='Male' datatype='integer' name='[Calculation_3214584994676477957]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Sex] = &quot;Males&quot; &#10;THEN [Pop] &#10;END' />
      </column>
      <column caption='Female' datatype='integer' name='[Calculation_3214584994678665223]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Sex] = &quot;Females&quot;&#10;THEN [Pop]&#10;END' />
      </column>
      <column caption='Population Density' datatype='real' name='[Calculation_3214584994685575176]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Pop]) / SUM(AREA([Geometry],&apos;km&apos;))' />
      </column>
      <column caption='log10 TotPop' datatype='real' name='[Calculation_3214584994688421897]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='LOG([Calculation_3214584994672668673])' />
      </column>
      <column caption='Log10 PopDen' datatype='real' name='[Calculation_3214584994688741386]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='log([Calculation_3214584994685575176],10)' />
      </column>
      <column caption='Population binned' datatype='string' name='[Calculation_3214584994690080779]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF ([Calculation_3214584994672668673]) &lt; WINDOW_PERCENTILE([Calculation_3214584994672668673], 0.33) THEN &quot;Low&quot;&#10;ELSEIF ([Calculation_3214584994672668673]) &lt; WINDOW_PERCENTILE([Calculation_3214584994672668673],0.66) THEN &quot;Medium&quot;&#10;ELSE &quot;High&quot;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Population Density binned' datatype='string' name='[Calculation_3214584994690633740]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF ([Calculation_3214584994685575176]) &lt; WINDOW_PERCENTILE([Calculation_3214584994685575176], 0.33) THEN &quot;Low&quot;&#10;ELSEIF ([Calculation_3214584994685575176]) &lt; WINDOW_PERCENTILE([Calculation_3214584994685575176],0.66) THEN &quot;Medium&quot;&#10;ELSE &quot;High&quot;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Combined' datatype='string' name='[Calculation_3214584994692821006]' role='measure' type='nominal'>
        <calculation class='tableau' formula='[Calculation_3214584994690080779] + &quot;-&quot; + [Calculation_3214584994690633740]'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
